-    injects. Either being present means we're frozen.
+    injects. Either being present means we're frozen. A Briefcase system-package
+    app counts too: ``sys.executable`` there is the app launcher, not a Python.
     """
-    return bool(getattr(sys, "frozen", False)) or hasattr(sys, "_MEIPASS")
+    return (
+        bool(getattr(sys, "frozen", False))
+        or hasattr(sys, "_MEIPASS")
+        or _is_briefcase_system_app()
+    )
 
 
