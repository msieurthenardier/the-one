__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/
.env
# Live-traffic HAT secrets: real bot tokens live in a local .env.hat, never
# committed. The `.env` rule above does NOT match `.env.hat` (different
# suffix), so this explicit pattern is required. The committed
# `tests/behavior/.env.hat.example` (placeholders only) documents the
# variable names (Mission 23 Flight 3 Leg 3 — the driver-bot replacement
# for the pre-reset `tests/live/discord_hat/` HAT, which is gone; the old
# path-scoped gitignore line for it is pruned here as dead).
*.env.hat
*.db
*.sqlite3
.ruff_cache/
.pytest_cache/
.claude/settings.local.json
.deploy-status.json
.memory/

# Agents' runtime scratch directory (squawk 0017) — created on demand,
# never a source of committed content.
workspace/

# Visual snapshot baselines and diagnostics — local regression artifacts only.
# Each developer regenerates locally with `pytest --snapshot-update`; not shared via git.
tests/browser/__snapshots__/

# WSL/Windows Alternate Data Stream sidecar files — created when files are
# downloaded via Windows browsers and the working tree lives on WSL.
*:Zone.Identifier
.claude/scheduled_tasks.lock

# Host-native `make up` runtime artifacts (M16 F03 L06) — local only.
# Port-suffixed pidfiles/logfiles (M17 F2 L3): .the-one.<port>.pid/.log
.the-one.pid
.the-one*.pid
.the-one.log
.the-one*.log

# F7 L12 HAT evidence (screenshots etc.) — local-only, regenerated per HAT walk.
missions/11-discord-connector-depth/flights/07-mentions-aware-response-policy/evidence/

# Behavior-test run evidence is written to an ephemeral path outside the
# project tree (default: /tmp/behavior-tests/<project>/<slug>/<ts>/), so
# nothing under tests/behavior/ needs to be gitignored. Only the spec
# (tests/behavior/<slug>.md) and the run log (.../runs/<ts>.md) live in
# the tree and are committed. Defensive guard kept below in case a future
# Executor mis-routes a write back into the source tree.
tests/behavior/*/runs/*/

# Frozen-installer output from `fly execute -o installer=./out` (M24 F01 L02).
# ~68 MB per run and never committed; anchored so a nested directory named
# `out` elsewhere in the tree is unaffected. Without this, every
# `fly execute -i repo=.` uploads the previous run's installer to the worker.
/out/

# Prompt evals (Mission 30): run output and the tiktoken cache are local-only.
evals/runs/
evals/.cache/
