# LLM Providers
# Default: ollama (local). Also supports openai, anthropic
THE_ONE_LLM_PROVIDER=ollama
THE_ONE_LLM_MODEL=qwen2.5:7b
THE_ONE_LLM_BASE_URL=http://localhost:11434/v1

# Cloud providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web UI
THE_ONE_HOST=127.0.0.1
THE_ONE_PORT=8484

# Origin allowlist extension (comma-separated). Defaults already cover
# 127.0.0.1/localhost/[::1] on any port plus the configured HOST:PORT.
# Add reverse-proxy hostnames here when deploying behind nginx/caddy.
# THE_ONE_ORIGIN_ALLOWLIST=http://example.local:8484
