+@functools.lru_cache(maxsize=1)
+def _is_briefcase_system_app() -> bool:
+    """True inside a Briefcase Linux system-package app.
+
+    Its C launcher embeds the distro's own Python and sets ``sys.executable`` to the
+    launcher (``/usr/bin/<name>``), sets no ``sys.frozen`` and no ``sys._MEIPASS``.
+    The marker is the layout it installs: ``<prefix>/lib/<name>/app_packages`` beside
+    the launcher's ``<prefix>/bin/<name>``.
+    """
+    exe = Path(sys.executable)
+    return (exe.parent.parent / "lib" / exe.name / "app_packages").is_dir()
+
+
