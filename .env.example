# Cloud LLM provider API keys (optional — only needed for the providers you use).
# LLM provider selection and model are configured via the admin UI, not env vars.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web UI
THE_ONE_HOST=127.0.0.1
THE_ONE_PORT=8484

# Log level. Controls Python logging verbosity. Default: INFO.
# THE_ONE_LOG_LEVEL=INFO

# Data directory. Stores the database and agent config files, plus the
# local-API credential file (api-credential, mode 0600 — see
# SECURITY-MODEL.md "Authentication"). Moving this directory moves the
# credential with it; `the-one rotate-api-credential` always operates on
# whichever directory is resolved here.
# Default: ~/.the-one
# THE_ONE_DATA_DIR=~/.the-one

# Origin allowlist extension (comma-separated). Defaults already cover
# 127.0.0.1/localhost/[::1] on any port plus the configured HOST:PORT.
# Add reverse-proxy hostnames here when deploying behind nginx/caddy.
# THE_ONE_ORIGIN_ALLOWLIST=http://example.local:8484

# Dev-mode gate: enables developer-facing routes that are NOT part of the
# normal operator surface (e.g. the /admin#design-language token-preview
# page, mock-provider creation in the admin UI). Default false; set to
# ``true`` only on a developer workstation. Production deployments MUST
# leave this unset — exposing these endpoints to a real user opens an
# unintended attack surface on the admin area.
# THE_ONE_DEV_MODE=true

# Web-session idle TTL (seconds). In-memory web chat sessions (_sessions in
# app.py) that have zero live WS subscribers AND have been idle beyond this
# threshold are evicted by a background reaper. The eviction releases the
# session's LLM HTTP client; the session rehydrates losslessly from the DB
# on the next join. Default 1800 (30 minutes). F05 L01 (Mission 12 F05).
# THE_ONE_WEB_SESSION_IDLE_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# Operational tunables — adjust for your deployment; safe to leave at defaults
# ---------------------------------------------------------------------------

# How long (seconds) a connector session may be continued after the last
# message before the server considers it expired. Default: 86400 (24 hours).
# THE_ONE_SESSION_CONTINUATION_SECONDS=86400

# Idle TTL (seconds) for connector pool entries. Pool entries whose last
# activity is older than this threshold are reaped by the background sweeper.
# Default: 1800 (30 minutes).
# THE_ONE_CONNECTOR_POOL_IDLE_TTL_SECONDS=1800

# How often (seconds) the connector pool refreshes the list of discoverable
# (account-keyed gateway listener) connectors. Default: 300 (5 minutes).
# THE_ONE_CONNECTOR_DISCOVERABLE_REFRESH_INTERVAL_SECONDS=300

# Idle TTL (seconds) for MCP client pool entries. MCP connections inactive
# longer than this are reaped. Default: 300 (5 minutes).
# MCP_POOL_IDLE_TTL_SECONDS=300

# How often (seconds) the daily chat-history purge loop wakes to check
# whether a sweep is due. The sweep is due-based — it runs only when >=24h
# have elapsed since the last purge (tracked by a global last_purge_at, with
# startup catch-up) — so this is just the coarse re-check cadence, not the
# purge interval. Floored at 60s. Default: 3600 (1 hour). M13 F03.
# THE_ONE_PURGE_CHECK_INTERVAL_SECONDS=3600

# Context-budget governor (M16 F08 L01). A single direction-aware governor at
# the agent's tool-dispatch boundary bounds EVERY tool result to a fraction of
# the active model's context window before it enters the conversation, so no one
# tool result can poison the context. budget_bytes = clamp(int(fraction *
# max_context_tokens * bytes_per_token), floor, ceiling), head-preserving by
# default (tail-preserving for shell/exec output so the exit-code/stderr tail
# survives). These three knobs tune it; all read at call time.
#   - FRACTION: share of the window one result may occupy. Default 0.125 (1/8).
#   - FLOOR/CEILING: absolute byte bounds on the computed budget. Defaults 8 KB
#     / 256 KB. (The 256 KB ceiling happens to equal the execution-tool
#     output_cap_bytes default — coincidence of sane sizing, not a coupling;
#     output_cap_bytes is now an independent transport/safety ceiling.)
# THE_ONE_TOOL_RESULT_BUDGET_FRACTION=0.125
# THE_ONE_TOOL_RESULT_BUDGET_FLOOR=8192
# THE_ONE_TOOL_RESULT_BUDGET_CEILING=262144

# Chat telemetry overlay — context-fullness warn/critical thresholds (M16 F08 L05).
# Percent of the model's context window at which the overlay bar turns orange
# (warn) then red (crit) and announces a non-color a11y state. Plumbed to the
# frontend via /api/config. Must satisfy 0 < WARN < CRIT <= 100; an invalid
# combination clamps back to the 70/90 defaults (logged), never crashes boot.
# THE_ONE_CONTEXT_WARN_PCT=70
# THE_ONE_CONTEXT_CRIT_PCT=90

# ---------------------------------------------------------------------------
# Dev / test seams — do NOT set in production
# ---------------------------------------------------------------------------

# THE_ONE_SANDBOX_DISABLED — disables the bubblewrap MCP sandbox. Only
# effective when THE_ONE_TEST_MODE=1 is also set (both required). Used
# exclusively by the test suite; never set in a real deployment.
# THE_ONE_SANDBOX_DISABLED=1

# THE_ONE_REGISTER_STUB_CONNECTOR — registers a stub connector type at
# startup. Dev-gated; for local connector-subsystem development only.
# THE_ONE_REGISTER_STUB_CONNECTOR=1

# THE_ONE_PURGE_SWEEP_TEST_ENDPOINT — exposes POST /api/_test/purge-sweep,
# which forces one daily chat-history purge sweep on demand (production
# fires only on the 24h due-check). Dual-gated: requires THE_ONE_DEV_MODE=true
# AND this flag = 1. Used by the agent-history-auto-purge behavior test;
# never set in a real deployment. M13 F03.
# THE_ONE_PURGE_SWEEP_TEST_ENDPOINT=1
