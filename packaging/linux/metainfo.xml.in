<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>@DISPLAY_NAME@</name>
  <icon type="stock">@DESKTOP_ID@</icon>
  <summary>@SUMMARY@</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@LICENSE@</project_license>
  <developer id="io.github.msieurthenardier">
    <name>msieurthenardier</name>
  </developer>
  <description>
    <p>@DESCRIPTION@</p>
  </description>
  <url type="homepage">@HOMEPAGE@</url>
  <!-- appstream wants categories once an icon is declared; derived from product.toml categories -->
  <categories>
    <category>@APPSTREAM_CATEGORY@</category>
  </categories>
  <launchable type="desktop-id">@DESKTOP_ID@.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@RELEASE_DATE@"/>
  </releases>
</component>
