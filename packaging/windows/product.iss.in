; product.iss -- GENERATED by packaging/render.py from packaging/product.toml. Do not edit, do not
; commit (it is gitignored). build.ps1 deletes and re-renders it on every build, so the version
; below is the version being built. the-one.iss #includes it: it is the only source of the
; installer's name, version and file names. The app GUID is deliberately NOT here: the AppId line
; in the-one.iss stays literal (a test pins it to product.toml), so the preprocessor never touches
; the "{{" the upgrade identity depends on.
#define AppName "@DISPLAY_NAME@"
#define AppVersion "@VERSION@"
#define AppPublisher "@PUBLISHER@"
#define AppURL "@HOMEPAGE@"
#define AppDirName "@INSTALL_DIR_NAME@"
#define CliExe "@CLI_EXECUTABLE@.exe"
#define GuiExe "@GUI_EXECUTABLE@.exe"
#define DistName "@CLI_EXECUTABLE@"
#define SetupStem "@SETUP_FILE_STEM@"
