__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/
.env
# Live-traffic HAT secrets (M11 F15 L3): real bot tokens live in a local
# .env.hat, never committed. The `.env` rule above does NOT match `.env.hat`
# (different suffix), so these explicit patterns are required. The committed
# `.env.hat.example` (placeholders only) documents the variable names.
tests/live/discord_hat/.env.hat
*.env.hat
*.db
*.sqlite3
.ruff_cache/
.pytest_cache/
.claude/settings.local.json
.deploy-status.json
.memory/
.flightops/

# Visual snapshot baselines and diagnostics — local regression artifacts only.
# Each developer regenerates locally with `pytest --snapshot-update`; not shared via git.
tests/browser/__snapshots__/

# WSL/Windows Alternate Data Stream sidecar files — created when files are
# downloaded via Windows browsers and the working tree lives on WSL.
*:Zone.Identifier
.claude/scheduled_tasks.lock

# F7 L12 HAT evidence (screenshots etc.) — local-only, regenerated per HAT walk.
missions/11-discord-connector-depth/flights/07-mentions-aware-response-policy/evidence/

# Behavior-test run evidence is written to an ephemeral path outside the
# project tree (default: /tmp/behavior-tests/<project>/<slug>/<ts>/), so
# nothing under tests/behavior/ needs to be gitignored. Only the spec
# (tests/behavior/<slug>.md) and the run log (.../runs/<ts>.md) live in
# the tree and are committed. Defensive guard kept below in case a future
# Executor mis-routes a write back into the source tree.
tests/behavior/*/runs/*/
