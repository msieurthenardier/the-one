# Briefcase configuration for GleepGlorp AI (Mission 32 Flight 1 spike, candidate B).
# Not wired into CI. build.sh copies this into the staging root as pyproject.toml, with
# @VERSION@ filled in; the root pyproject.toml is never touched (DD3).

[project]
name = "the-one"
version = "@VERSION@"
description = "GleepGlorp AI, a personal LLM-powered agent"
license = "LicenseRef-Proprietary"
license-files = ["LICENSE.txt"]

[tool.briefcase]
project_name = "the-one"
bundle = "ai.gleepglorp"
version = "@VERSION@"
url = "https://example.invalid/gleepglorp-ai"
author = "GleepGlorp AI"
author_email = "noreply@invalid.example"

[tool.briefcase.app.the-one]
formal_name = "GleepGlorp AI"
description = "GleepGlorp AI, a personal LLM-powered agent"
long_description = """GleepGlorp AI is a personal LLM-powered agent. This package runs it on the
system Python and the desktop's own GTK 3 and WebKitGTK 4.1.
Spike prototype for Mission 32 Flight 1; not a release.
"""
icon = "icon"
sources = ["the_one"]
# pinned dependency closure, generated by build.sh from `uv export` (hash-pinned file)
requires = @REQUIRES@
# --no-deps: the exported closure is complete (candidate A installs it with --no-deps too); without it pip also
# resolves huggingface-hub's optional hf-xet, which the lock leaves out, and --require-hashes then refuses it
requirement_installer_args = ["--no-deps", "--require-hashes"]
# the bootstrap launcher leaves sys.executable empty unless this is set; the app's
# resolve_python() (and so MCP stdio, shell, python_exec) needs a real interpreter
allow_subprocesses = true

[tool.briefcase.app.the-one.linux.system.debian]
# build image: compile PyGObject 3.56 (girepository-2.0) and pycairo against the distro's dev packages
system_requires = [
    "pkg-config",
    "libcairo2-dev",
    "libgirepository-2.0-dev",
    "gobject-introspection",
]
# runtime: the GTK / WebKitGTK / introspection / AppIndicator stack; same list as candidate A's .deb.
# `python3` is added by hand: Briefcase writes only libc6 and libpython3.<minor>.
# No `a | b` alternatives: the list is pasted unquoted into a Dockerfile apt-get line.
system_runtime_requires = [
    "python3",
    "libwebkit2gtk-4.1-0",
    "gir1.2-webkit2-4.1",
    "gir1.2-gtk-3.0",
    "libgirepository-2.0-0",
    "gir1.2-ayatanaappindicator3-0.1",
    "libcairo2",
]

[tool.briefcase.app.the-one.macOS]
# macOS (hosted probe, Mission 32 Flight 1 leg 4). The Python in the app is Briefcase's own
# framework support package, so there is no system_requires / system_runtime_requires here.
#
# arm64 only. The default (universal_build = true) installs the binary packages a second time
# for x86_64 as bare `name==version` pins, which `--require-hashes` below refuses; and the
# hosted runner is Apple Silicon.
universal_build = false
# Explicit, not left to the support package's default: the lowest macOS tag at which the whole
# hash-pinned closure resolves for arm64 wheels (rehearsed on Linux with `pip download
# --platform macosx_<V>_arm64`: 11_0, 12_0 and 14_0 all resolve; 10_9 fails at cffi, which has
# no arm64 wheel below 11.0).
min_os_version = "11.0"
# Briefcase passes `--only-binary :all:` on macOS. `proxy-tools` (a pywebview dependency on every
# platform) is the one pure-Python package that ships only an sdist, so it is the one exception.
# Its sdist hash is already in the hashed closure, so --require-hashes still holds. The Linux
# section keeps its own args (no --only-binary there).
requirement_installer_args = ["--no-deps", "--require-hashes", "--no-binary", "proxy-tools"]

[tool.briefcase.app.the-one.macOS.info]
# Retina rendering for the web view; the Briefcase template's Info.plist does not set it.
NSHighResolutionCapable = true
