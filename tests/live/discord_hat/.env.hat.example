# Live-traffic Discord HAT — environment template (M11 F15 L3).
#
# Copy to `.env.hat` (gitignored) and fill in REAL values, then export
# before running `make test-discord-hat`. NEVER commit real tokens —
# `.env.hat` and `*.env.hat` are gitignored; only this `.example` (with
# placeholders) is committed.
#
#   set -a; . tests/live/discord_hat/.env.hat; set +a
#   make test-discord-hat
#
# With NONE of these set, the discord_hat tests SKIP (they never error) and
# the normal backend suite never collects them.

# --- Sender-bot tokens ---
# Either a comma-separated list (preferred)...
THE_ONE_HAT_BOT_TOKENS=token-bot-1,token-bot-2,token-bot-3
# ...or the numbered fallback (used only if THE_ONE_HAT_BOT_TOKENS is empty):
# THE_ONE_HAT_BOT_TOKEN_1=token-bot-1
# THE_ONE_HAT_BOT_TOKEN_2=token-bot-2
# THE_ONE_HAT_BOT_TOKEN_3=token-bot-3

# --- Test guild + channels ---
THE_ONE_HAT_GUILD_ID=000000000000000000
# Comma-separated; the smoke uses channel_ids[0].
THE_ONE_HAT_CHANNEL_IDS=000000000000000001,000000000000000002,000000000000000003

# --- The-one's test connector id (the connector that ingests the bots) ---
THE_ONE_HAT_CONNECTOR_ID=replace-with-test-connector-id

# --- The-one's OWN Discord bot user id ---
# Gateway-assigned; the-one does NOT persist it to the API. Needed to build
# the @mention string and to address DMs to the-one.
THE_ONE_HAT_BOT_USER_ID=000000000000000099

# --- Burner-bot user ids (OPTIONAL) ---
# Comma-separated Discord user ids of the sender bots, in token order.
# Required only for the ACL/peers-axis tests (test_multi_user,
# test_pairing_peers_decoupling). The other scenarios (smoke, multi_channel,
# multi_agent) skip this var entirely; absence does NOT cause them to skip.
# Find each bot's user id in the Discord Developer Portal → Applications →
# <bot app> → General Information → "Application ID" (== bot user id).
# THE_ONE_HAT_BOT_USER_IDS=000000000000000001,000000000000000002,000000000000000003

# --- the-one HTTP base URL (optional; defaults to http://localhost:8484) ---
# THE_ONE_TEST_URL=http://localhost:8484
